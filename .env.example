# Copy this file to .env locally. Never commit .env or paste real values in source files.
CLASSROOM_AGENT_EMBEDDING_ENABLED=true
CLASSROOM_AGENT_EMBEDDING_API_KEY=
CLASSROOM_AGENT_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CLASSROOM_AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding
CLASSROOM_AGENT_EMBEDDING_DIMENSIONS=1024
CLASSROOM_AGENT_EMBEDDING_BATCH_SIZE=20
CLASSROOM_AGENT_VECTOR_ENABLED=true
CLASSROOM_QDRANT_URL=http://localhost:6333
CLASSROOM_AGENT_RERANK_ENABLED=true
# Leave empty to derive https://WORKSPACE.../compatible-api/v1/reranks from the embedding URL.
CLASSROOM_AGENT_RERANK_BASE_URL=
# Leave empty to reuse CLASSROOM_AGENT_EMBEDDING_API_KEY.
CLASSROOM_AGENT_RERANK_API_KEY=
CLASSROOM_AGENT_RERANK_MODEL=qwen3-rerank
CLASSROOM_AGENT_RERANK_CANDIDATE_LIMIT=30
CLASSROOM_AGENT_RERANK_WEIGHT=0.35

CLASSROOM_AGENT_LANGCHAIN_ENABLED=true
CLASSROOM_AGENT_LANGCHAIN_API_KEY=
CLASSROOM_AGENT_LANGCHAIN_BASE_URL=https://api.deepseek.com/v1
CLASSROOM_AGENT_LANGCHAIN_MODEL=deepseek-chat

# Configure the current provider prices shown in its billing console. Unit: CNY / 1M tokens.
# Keep zero when the account uses a free quota or when no reliable price has been configured.
CLASSROOM_AGENT_COST_CURRENCY=CNY
CLASSROOM_AGENT_LLM_INPUT_PRICE_PER_MILLION=0
CLASSROOM_AGENT_LLM_OUTPUT_PRICE_PER_MILLION=0
CLASSROOM_AGENT_EMBEDDING_PRICE_PER_MILLION=0
CLASSROOM_AGENT_RERANK_PRICE_PER_MILLION=0
